# ==========================================================
# EDUMENTOR AI - Environment Variables
# ==========================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# JWT Secret Key for Session Authentication
JWT_SECRET=edumentor_super_secret_jwt_key_academic_2026_secure
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection URL (Optional)
# If left empty, EduMentor AI automatically uses the zero-config embedded SQLite database (data/edumentor.db)
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5433/edumentor
DATABASE_URL=

# Google Gemini API Key
# Required for live generative AI advising, career roadmaps, and resume analysis.
# If left blank, EduMentor AI gracefully activates its intelligent deterministic advisory engine for offline/demo reliability.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
